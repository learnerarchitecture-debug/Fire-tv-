<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="false"/>

    <LinearLayout
        android:id="@+id/drawer_sheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/drawer_sheet_h"
        android:layout_gravity="bottom"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        android:background="@drawable/drawer_sheet_bg"
        android:elevation="24dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:background="@drawable/drawer_handle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apps"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/drawer_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/apps_lead"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/drawer_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/settings_close_bg"
                android:contentDescription="@string/close"
                android:focusable="true"
                android:clickable="true">

                <com.aurora.home.IconView
                    android:id="@+id/drawer_close_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"/>
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <GridView
                android:id="@+id/drawer_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="6"
                android:horizontalSpacing="6dp"
                android:verticalSpacing="4dp"
                android:stretchMode="columnWidth"
                android:gravity="center"
                android:listSelector="@android:color/transparent"
                android:drawSelectorOnTop="false"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:fadingEdge="vertical"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/apps_empty"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone"/>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/apps_hint"
            android:textColor="@color/text_hint"
            android:textSize="7.5sp"
            android:letterSpacing="0.14"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
