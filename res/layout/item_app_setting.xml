<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/settings_row_h"
    android:minHeight="@dimen/settings_row_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/setting_row_bg"
    android:paddingLeft="10dp"
    android:paddingRight="9dp"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/a_icon"
        android:layout_width="@dimen/settings_row_icon"
        android:layout_height="@dimen/settings_row_icon"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/a_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_title_size"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/a_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_summary_size"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <Switch
        android:id="@+id/a_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:focusable="false"
        android:clickable="false"
        android:scaleX="0.78"
        android:scaleY="0.78"/>
</LinearLayout>
