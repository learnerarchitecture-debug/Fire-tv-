<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_base</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_default</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="DrawerTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="GlassDialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FFFFB45E</item>
        <item name="android:windowBackground">@drawable/glass_dialog_bg</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:backgroundDimAmount">0.68</item>
        <item name="android:windowMinWidthMajor">45%</item>
        <item name="android:windowMinWidthMinor">55%</item>
        <item name="android:buttonBarButtonStyle">@style/GlassDialogButton</item>
    </style>

    <style name="GlassDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_button_bg</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
    </style>

    <style name="AccentAmber">
        <item name="android:colorAccent">#FFFFB45E</item>
        <item name="android:colorControlActivated">#FFFFB45E</item>
    </style>

    <style name="AccentCoral">
        <item name="android:colorAccent">#FFFF7A6B</item>
        <item name="android:colorControlActivated">#FFFF7A6B</item>
    </style>

    <style name="AccentViolet">
        <item name="android:colorAccent">#FFA99BFF</item>
        <item name="android:colorControlActivated">#FFA99BFF</item>
    </style>

    <style name="AccentMint">
        <item name="android:colorAccent">#FF5FE3C0</item>
        <item name="android:colorControlActivated">#FF5FE3C0</item>
    </style>

    <style name="AccentBlue">
        <item name="android:colorAccent">#FF7FB7FF</item>
        <item name="android:colorControlActivated">#FF7FB7FF</item>
    </style>

    <style name="GlassDialogTheme_Coral" parent="GlassDialogTheme">
        <item name="android:colorAccent">#FFFF7A6B</item>
    </style>

    <style name="GlassDialogTheme_Violet" parent="GlassDialogTheme">
        <item name="android:colorAccent">#FFA99BFF</item>
    </style>

    <style name="GlassDialogTheme_Mint" parent="GlassDialogTheme">
        <item name="android:colorAccent">#FF5FE3C0</item>
    </style>

    <style name="GlassDialogTheme_Blue" parent="GlassDialogTheme">
        <item name="android:colorAccent">#FF7FB7FF</item>
    </style>
</resources>
